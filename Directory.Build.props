<Project>
  <PropertyGroup>
    <!-- Shared publisher and author information -->
    <Authors>Reda Essa</Authors>
    <Company>EssaLab</Company>
    <Copyright>Copyright © EssaLab 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Logo and README settings to appear on NuGet -->
    <PackageIcon>logo.png</PackageIcon>
    <!-- Repository links -->
    <RepositoryUrl>https://github.com/EssaLab/Zid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/EssaLab/Zid</PackageProjectUrl>

    <!-- General code and documentation settings -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Default shared package version -->
    <Version>1.0.3</Version>
  </PropertyGroup>

  <!-- Automatically include logo file in all packages on pack -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)logo.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)logo.png')" />
  </ItemGroup>
</Project>